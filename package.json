{
  "name": "@choco-vanille/ui",
  "version": "2.2.3",
  "description": "A React 19 UI kit built with Vanilla Extract and Base UI primitives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LilianMrzt/choco-vanille-ui.git"
  },
  "homepage": "https://github.com/LilianMrzt/choco-vanille-ui#readme",
  "bugs": {
    "url": "https://github.com/LilianMrzt/choco-vanille-ui/issues"
  },
  "keywords": [
    "react",
    "ui-kit",
    "vanilla-extract",
    "base-ui",
    "storybook"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "start": "serve storybook-static -p $PORT",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "audit:design-system": "node --experimental-strip-types scripts/audit/audit-design-system.ts",
    "audit:design-system:check": "node --experimental-strip-types scripts/audit/audit-design-system.ts --strict",
    "typecheck": "tsc --noEmit",
    "build-storybook": "storybook build",
    "build:lib": "vite build",
    "prepublishOnly": "pnpm run build:lib",
    "test": "vitest"
  },
  "peerDependencies": {
    "@iconify/react": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@iconify-icons/lucide": "^2.0.28",
    "@tiptap/extension-color": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "react-easy-crop": "^6.2.4",
    "serve": "^14.2.6",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify/react": "^5.2.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "add": "^2.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.5",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
