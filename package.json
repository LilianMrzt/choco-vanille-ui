{
  "name": "@choco-vanille/ui",
  "version": "1.10.0",
  "description": "A React 19 UI kit built with Vanilla Extract and Base UI primitives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LilianMrzt/choco-vanille-ui.git"
  },
  "homepage": "https://github.com/LilianMrzt/choco-vanille-ui#readme",
  "bugs": {
    "url": "https://github.com/LilianMrzt/choco-vanille-ui/issues"
  },
  "keywords": [
    "react",
    "ui-kit",
    "vanilla-extract",
    "base-ui",
    "storybook"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "start": "serve storybook-static -p $PORT",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "audit:design-system": "node --experimental-strip-types scripts/audit/audit-design-system.ts",
    "audit:design-system:check": "node --experimental-strip-types scripts/audit/audit-design-system.ts --strict",
    "typecheck": "tsc --noEmit",
    "build-storybook": "storybook build",
    "build:lib": "vite build",
    "prepublishOnly": "pnpm run build:lib",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/recipes": "0.5.7",
    "react-day-picker": "^10.0.1",
    "serve": "^14.2.6",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vanilla-extract/vite-plugin": "5.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "add": "^2.0.6",
    "eslint": "10.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.5.6",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
